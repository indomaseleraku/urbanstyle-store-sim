# ==============================================================================
# URBANSTYLE STORE - SISTEM INFORMASI MANAJEMEN (SIM)
# Template Konfigurasi Environment Variable (.env.local)
# Salin file ini menjadi .env.local kemudian sesuaikan dengan environment Anda:
# ==============================================================================

# 1. Konfigurasi Supabase Cloud (PostgreSQL & Auth)
# Dapatkan Project URL & Anon Key dari https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 2. QRIS Statis Merchant (Format Standar EMVCo Bank Indonesia)
# Default payload dummy standar EMVCo (Nama: URBANSTYLE STORE, Kota: JAKARTA)
NEXT_PUBLIC_QRIS_STATIC_PAYLOAD=00020101021126610014COM.GO-JEK.WWW01189360091431037768610210G1037768610303UMI51440014ID.CO.QRIS.WWW0215ID10999999999990303UMI5204581253033605802ID5916URBANSTYLE STORE6007JAKARTA61051011062070703A01630405A3

# 3. Kunci Keamanan & Proteksi Webhook
PAYMENT_WEBHOOK_SECRET=your_secure_payment_webhook_secret_key_here
SESSION_SECRET=your_super_secret_hmac_session_key_min_32_characters

# 4. Google OAuth 2.0 (Opsional, melalui Supabase Auth Provider)
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# 5. Konfigurasi SMTP Gmail (Opsional untuk OTP 6 Digit & Email Notifikasi)
GMAIL_SMTP_USER=your-email@gmail.com
GMAIL_SMTP_APP_PASSWORD=your-gmail-16-char-app-password
GMAIL_SENDER_NAME=UrbanStyle LifeWear Store
